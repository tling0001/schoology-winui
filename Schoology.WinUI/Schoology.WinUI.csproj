<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Schoology.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2026.10.0-port.1</Version>
    <AssemblyVersion>2026.10.0.1</AssemblyVersion>
    <FileVersion>2026.10.0.1</FileVersion>
    <InformationalVersion>2026.10.0-port.1</InformationalVersion>
    <AssemblyName>Schoology.WinUI</AssemblyName>
    <ApplicationIcon>Assets\\Schoology.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260803003" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <!-- Unpackaged WinUI apps resolve compiled XAML through the PRI resource
       index. Preserve that index beside the executable when publishing. -->
  <Target Name="CopyWinUIResourceIndexToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIResourceIndex Include="$(TargetDir)*.pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WinUIResourceIndex)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="'@(_WinUIResourceIndex)' != ''" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Assets\\logo_schoology.png" />
    <EmbeddedResource Include="Assets\\ic_school.svg" />
    <EmbeddedResource Include="Assets\\ic_sgy_logo.svg" />
    <EmbeddedResource Include="Assets\\ic_qr_code.svg" />
    <EmbeddedResource Include="Assets\\Schoology.ico" />
  </ItemGroup>
</Project>
